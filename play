<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>道德侦探 · 魔丸团</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: "Microsoft YaHei", "PingFang SC", sans-serif;
    background: linear-gradient(135deg, #1a1a2e, #16213e, #0f3460);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    color: #fff;
  }

  .game {
    width: 100%;
    max-width: 680px;
    background: rgba(255, 255, 255, 0.08);
    border: 2px solid rgba(255, 255, 255, 0.15);
    border-radius: 24px;
    padding: 28px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(10px);
  }

  /* ============ 主页 ============ */
  .home { text-align: center; animation: fadeIn 0.6s; }

  .home .logo {
    font-size: 40px;
    margin-bottom: 8px;
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .home h1 {
    font-size: 34px;
    color: #ffd369;
    letter-spacing: 4px;
    margin-bottom: 10px;
    text-shadow: 0 0 20px rgba(255, 211, 105, 0.5);
  }

  .home .tagline {
    font-size: 15px;
    color: #aaa;
    margin-bottom: 30px;
    line-height: 1.8;
  }

  .home .start-btn {
    width: 100%;
    padding: 18px;
    border-radius: 16px;
    border: none;
    background: linear-gradient(135deg, #ffd369, #ffb347);
    color: #1a1a2e;
    font-size: 20px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
    margin-bottom: 12px;
    box-shadow: 0 8px 24px rgba(255, 211, 105, 0.35);
  }

  .home .start-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(255, 211, 105, 0.5);
  }

  .home .secondary-btn {
    width: 100%;
    padding: 14px;
    border-radius: 16px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    background: transparent;
    color: #ccc;
    font-size: 15px;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s;
  }

  .home .secondary-btn:hover {
    border-color: #ffd369;
    color: #ffd369;
  }

  /* ============ 故事页 ============ */
  .story { animation: fadeIn 0.6s; }

  .story-scene {
    background: rgba(0, 0, 0, 0.3);
    border-radius: 20px;
    padding: 24px;
    margin-bottom: 20px;
    min-height: 260px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .story-scene .illustration {
    width: 100%;
    max-width: 340px;
    margin-bottom: 16px;
  }

  .story-scene .story-text {
    font-size: 16px;
    line-height: 1.9;
    color: #eee;
  }

  .story-scene .story-text strong { color: #ffd369; }

  .story .next-btn {
    width: 100%;
    padding: 16px;
    border-radius: 14px;
    border: none;
    background: linear-gradient(135deg, #4ecca3, #3aa17e);
    color: #fff;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s;
  }

  .story .next-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(78, 204, 163, 0.4);
  }

  .story .skip-btn {
    width: 100%;
    padding: 12px;
    border-radius: 14px;
    border: none;
    background: transparent;
    color: #888;
    font-size: 14px;
    cursor: pointer;
    font-family: inherit;
    margin-top: 8px;
  }

  .story .skip-btn:hover { color: #ffd369; }

  /* ============ 游戏页 ============ */
  .progress {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-bottom: 20px;
  }

  .dot {
    width: 14px; height: 14px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    transition: all 0.3s;
    position: relative;
  }
  .dot.active { background: #ffd369; box-shadow: 0 0 12px #ffd369; transform: scale(1.2); }
  .dot.done { background: #4ecca3; }
  .dot.wrong { background: #ff6b6b; }

  .scene-illustration {
    width: 100%;
    margin-bottom: 16px;
    border-radius: 16px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.2);
    padding: 12px;
  }

  .scene-card {
    background: rgba(0, 0, 0, 0.25);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 20px;
  }

  .scene-card h2 {
    font-size: 18px;
    color: #4ecca3;
    margin-bottom: 10px;
  }

  .scene-card p {
    font-size: 16px;
    line-height: 1.7;
    color: #eee;
  }

  .question {
    font-size: 16px;
    color: #ffd369;
    text-align: center;
    margin-bottom: 16px;
    font-weight: bold;
  }

  .suspects {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 16px;
  }

  .suspect {
    padding: 16px 18px;
    border-radius: 14px;
    border: 2px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    font-size: 15px;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .suspect:hover {
    background: rgba(255, 211, 105, 0.12);
    border-color: #ffd369;
    transform: translateX(6px);
  }

  .suspect:disabled { cursor: not-allowed; opacity: 0.5; }
  .suspect.correct { background: rgba(78, 204, 163, 0.2); border-color: #4ecca3; }
  .suspect.wrong { background: rgba(255, 107, 107, 0.2); border-color: #ff6b6b; }

  .suspect .avatar {
    width: 40px; height: 40px;
    border-radius: 50%;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
  }

  .suspect .info { flex: 1; }
  .suspect .name { font-weight: bold; color: #ffd369; font-size: 15px; }
  .suspect .desc { font-size: 13px; color: #bbb; margin-top: 2px; }

  .feedback {
    padding: 16px;
    border-radius: 14px;
    margin-bottom: 16px;
    font-size: 15px;
    line-height: 1.7;
    display: none;
    animation: fadeIn 0.3s;
  }

  .feedback.show { display: block; }
  .feedback.hint { background: rgba(255, 211, 105, 0.15); border: 1px solid #ffd369; color: #ffd369; }
  .feedback.correct { background: rgba(78, 204, 163, 0.15); border: 1px solid #4ecca3; color: #4ecca3; }
  .feedback.wrong { background: rgba(255, 107, 107, 0.15); border: 1px solid #ff6b6b; color: #ff6b6b; }

  .action-btn {
    width: 100%;
    padding: 16px;
    border-radius: 14px;
    border: none;
    background: linear-gradient(135deg, #4ecca3, #3aa17e);
    color: #fff;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s;
    margin-top: 8px;
  }

  .action-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(78, 204, 163, 0.4);
  }

  /* ============ 结算 ============ */
  .report { animation: fadeIn 0.6s; text-align: center; }

  .report .trophy {
    font-size: 60px;
    margin-bottom: 12px;
    animation: float 3s ease-in-out infinite;
  }

  .report h2 {
    font-size: 26px;
    color: #ffd369;
    margin-bottom: 12px;
  }

  .report .result-title {
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 8px;
  }

  .report .result-desc {
    font-size: 15px;
    color: #ccc;
    line-height: 1.8;
    margin-bottom: 24px;
    padding: 0 20px;
  }

  .report .score-box {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 24px;
  }

  .report .score-item {
    background: rgba(0, 0, 0, 0.3);
    border-radius: 16px;
    padding: 16px 24px;
    min-width: 100px;
  }

  .report .score-item .num {
    font-size: 32px;
    font-weight: bold;
    color: #4ecca3;
  }

  .report .score-item .label {
    font-size: 13px;
    color: #aaa;
    margin-top: 4px;
  }

  .report .captured-list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-bottom: 24px;
  }

  .report .captured {
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 14px;
    background: rgba(78, 204, 163, 0.2);
    border: 1px solid #4ecca3;
    color: #4ecca3;
  }

  .report .escaped {
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 14px;
    background: rgba(255, 107, 107, 0.2);
    border: 1px solid #ff6b6b;
    color: #ff6b6b;
  }

  .name-input {
    width: 100%;
    padding: 14px 16px;
    border-radius: 12px;
    border: 2px solid rgba(255, 255, 255, 0.2);
    background: rgba(0, 0, 0, 0.3);
    color: #fff;
    font-size: 15px;
    font-family: inherit;
    margin-bottom: 12px;
    outline: none;
    text-align: center;
  }
  .name-input:focus { border-color: #ffd369; }

  .leaderboard {
    margin-top: 24px;
    background: rgba(0, 0, 0, 0.25);
    border-radius: 16px;
    padding: 18px;
    text-align: left;
  }
  .leaderboard h3 {
    font-size: 16px;
    color: #4ecca3;
    margin-bottom: 12px;
    text-align: center;
  }
  .leaderboard ol { list-style: none; }
  .leaderboard li {
    display: flex;
    justify-content: space-between;
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 14px;
    color: #ddd;
    margin-bottom: 6px;
    background: rgba(255, 255, 255, 0.05);
  }
  .leaderboard li.top1 { background: rgba(255, 211, 105, 0.2); color: #ffd369; font-weight: bold; }
  .leaderboard li.top2 { background: rgba(192, 192, 192, 0.15); color: #ddd; }
  .leaderboard li.top3 { background: rgba(205, 127, 50, 0.15); color: #e0a060; }
  .leaderboard .empty { text-align: center; color: #888; font-size: 14px; }

  .hidden { display: none; }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
</head>
<body>

<div class="game">

  <!-- ============ 主页 ============ -->
  <div class="home" id="homePage">
    <div class="logo">🕵️‍♂️</div>
    <h1>道德侦探</h1>
    <div class="tagline">
      魔丸团伪装成学生，混进了学校。<br>
      你是侦探，要在 5 个情境中找出他们。
    </div>
    <button class="start-btn" id="startBtn">🔍 开始调查</button>
    <button class="secondary-btn" id="homeLeaderboardBtn">🏆 查看排行榜</button>

    <div class="leaderboard hidden" id="homeLeaderboard" style="margin-top:20px;">
      <h3>🏆 排行榜（前 5 名）</h3>
      <ol id="homeLeaderboardList"></ol>
    </div>
  </div>

  <!-- ============ 故事页 ============ -->
  <div class="story hidden" id="storyPage">
    <div class="story-scene">
      <div class="illustration" id="storyIllustration"></div>
      <div class="story-text" id="storyText"></div>
    </div>
    <button class="next-btn" id="storyNextBtn">继续 →</button>
    <button class="skip-btn" id="storySkipBtn">跳过故事</button>
  </div>

  <!-- ============ 游戏页 ============ -->
  <div class="game-page hidden" id="gamePage">
    <div class="progress" id="progress"></div>

    <div class="scene-illustration" id="sceneIllustration"></div>

    <div class="scene-card">
      <h2 id="sceneTitle"></h2>
      <p id="sceneText"></p>
    </div>

    <div class="question" id="questionText">❓ 谁是魔丸团成员？</div>

    <div class="suspects" id="suspects"></div>

    <div class="feedback" id="feedback"></div>

    <button class="action-btn hidden" id="nextLevelBtn">下一关 →</button>
  </div>

  <!-- ============ 结算页 ============ -->
  <div class="report hidden" id="reportPage">
    <div class="trophy" id="trophy">🏆</div>
    <h2>🕵️ 侦探报告</h2>
    <div class="result-title" id="resultTitle"></div>
    <div class="result-desc" id="resultDesc"></div>

    <div class="score-box">
      <div class="score-item">
        <div class="num" id="capturedCount">0</div>
        <div class="label">抓到魔丸团</div>
      </div>
      <div class="score-item">
        <div class="num" id="totalScore">0</div>
        <div class="label">总分</div>
      </div>
    </div>

    <div class="captured-list" id="capturedList"></div>

    <input type="text" class="name-input" id="playerName" placeholder="输入你的名字，保存到排行榜" maxlength="10">
    <button class="action-btn" id="saveBtn">💾 保存到排行榜</button>
    <button class="secondary-btn" id="restartBtn" style="margin-top:12px;">🔁 再玩一次</button>

    <div class="leaderboard">
      <h3>🏆 排行榜（前 5 名）</h3>
      <ol id="leaderboardList"></ol>
    </div>
  </div>

</div>

<script>
// ============================================================
// 音效（Web Audio，无需外部文件）
// ============================================================
let audioCtx = null;
function getAudioCtx() {
  if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  return audioCtx;
}
function playTone(freq, duration, type = 'sine', volume = 0.15) {
  try {
    const ctx = getAudioCtx();
    const osc = ctx.createOscillator();
    const gain = ctx.createGain();
    osc.type = type;
    osc.frequency.value = freq;
    gain.gain.setValueAtTime(volume, ctx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + duration);
    osc.connect(gain);
    gain.connect(ctx.destination);
    osc.start();
    osc.stop(ctx.currentTime + duration);
  } catch (e) {}
}
function sfxClick() { playTone(600, 0.08, 'square', 0.06); }
function sfxCorrect() {
  playTone(523, 0.12, 'sine', 0.15);
  setTimeout(() => playTone(659, 0.12, 'sine', 0.15), 100);
  setTimeout(() => playTone(784, 0.2, 'sine', 0.15), 200);
}
function sfxWrong() {
  playTone(300, 0.15, 'sawtooth', 0.1);
  setTimeout(() => playTone(200, 0.25, 'sawtooth', 0.1), 120);
}
function sfxHint() {
  playTone(440, 0.15, 'triangle', 0.1);
  setTimeout(() => playTone(550, 0.15, 'triangle', 0.1), 130);
}
function sfxFinish() {
  const notes = [523, 659, 784, 1047];
  notes.forEach((n, i) => setTimeout(() => playTone(n, 0.25, 'sine', 0.15), i * 150));
}


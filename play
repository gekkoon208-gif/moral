// ============================================================
// 状态
// ============================================================
let currentLevel = 0;
let storyIndex = 0;
let triedWrong = false; // 本关是否已经选错一次
let captured = [];      // 抓到的魔丸团成员名
let results = [];       // 每关结果：true/false
let totalScore = 0;

// ============================================================
// DOM
// ============================================================
const homePage = document.getElementById('homePage');
const storyPage = document.getElementById('storyPage');
const gamePage = document.getElementById('gamePage');
const reportPage = document.getElementById('reportPage');

const startBtn = document.getElementById('startBtn');
const homeLeaderboardBtn = document.getElementById('homeLeaderboardBtn');
const homeLeaderboard = document.getElementById('homeLeaderboard');
const homeLeaderboardList = document.getElementById('homeLeaderboardList');

const storyIllustration = document.getElementById('storyIllustration');
const storyText = document.getElementById('storyText');
const storyNextBtn = document.getElementById('storyNextBtn');
const storySkipBtn = document.getElementById('storySkipBtn');

const progressEl = document.getElementById('progress');
const sceneIllustration = document.getElementById('sceneIllustration');
const sceneTitle = document.getElementById('sceneTitle');
const sceneText = document.getElementById('sceneText');
const questionText = document.getElementById('questionText');
const suspectsEl = document.getElementById('suspects');
const feedbackEl = document.getElementById('feedback');
const nextLevelBtn = document.getElementById('nextLevelBtn');

const trophy = document.getElementById('trophy');
const resultTitle = document.getElementById('resultTitle');
const resultDesc = document.getElementById('resultDesc');
const capturedCount = document.getElementById('capturedCount');
const totalScoreEl = document.getElementById('totalScore');
const capturedList = document.getElementById('capturedList');
const playerName = document.getElementById('playerName');
const saveBtn = document.getElementById('saveBtn');
const restartBtn = document.getElementById('restartBtn');
const leaderboardList = document.getElementById('leaderboardList');

// ============================================================
// 页面切换
// ============================================================
function showPage(page) {
  [homePage, storyPage, gamePage, reportPage].forEach(p => p.classList.add('hidden'));
  page.classList.remove('hidden');
}

// ============================================================
// 主页
// ============================================================
startBtn.onclick = () => {
  sfxClick();
  storyIndex = 0;
  currentLevel = 0;
  triedWrong = false;
  captured = [];
  results = [];
  totalScore = 0;
  renderStory();
  showPage(storyPage);
};

homeLeaderboardBtn.onclick = () => {
  sfxClick();
  homeLeaderboard.classList.toggle('hidden');
  if (!homeLeaderboard.classList.contains('hidden')) {
    renderLeaderboard(homeLeaderboardList);
  }
};

// ============================================================
// 故事页
// ============================================================
function renderStory() {
  const page = storyPages[storyIndex];
  storyIllustration.innerHTML = page.illustration;
  storyText.innerHTML = page.text;
  storyNextBtn.textContent = storyIndex === storyPages.length - 1 ? '开始调查 →' : '继续 →';
}

storyNextBtn.onclick = () => {
  sfxClick();
  storyIndex++;
  if (storyIndex >= storyPages.length) {
    startGame();
  } else {
    renderStory();
  }
};

storySkipBtn.onclick = () => {
  sfxClick();
  startGame();
};

// ============================================================
// 游戏
// ============================================================
function startGame() {
  currentLevel = 0;
  triedWrong = false;
  renderLevel();
  showPage(gamePage);
}

function renderProgress() {
  progressEl.innerHTML = '';
  for (let i = 0; i < levels.length; i++) {
    const dot = document.createElement('div');
    dot.className = 'dot';
    if (i < currentLevel) {
      dot.classList.add(results[i] ? 'done' : 'wrong');
    } else if (i === currentLevel) {
      dot.classList.add('active');
    }
    progressEl.appendChild(dot);
  }
}

function shuffle(arr) {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function renderLevel() {
  const level = levels[currentLevel];
  triedWrong = false;

  sceneIllustration.innerHTML = level.illustration;
  sceneTitle.textContent = level.title;
  sceneText.textContent = level.scene;
  questionText.textContent = '❓ 谁是魔丸团成员？';

  const shuffled = shuffle(level.suspects);

  suspectsEl.innerHTML = '';
  shuffled.forEach((s, i) => {
    const btn = document.createElement('button');
    btn.className = 'suspect';
    btn.innerHTML = `
      <div class="avatar">${s.avatar}</div>
      <div class="info">
        <div class="name">${s.name}</div>
        <div class="desc">${s.desc}</div>
      </div>
    `;
    btn.onclick = () => selectSuspect(s, btn, shuffled);
    suspectsEl.appendChild(btn);
  });

  feedbackEl.className = 'feedback';
  feedbackEl.innerHTML = '';
  nextLevelBtn.classList.add('hidden');

  renderProgress();
}

function selectSuspect(suspect, btn, shuffled) {
  if (suspect.isCulprit) {
    // 选对
    sfxCorrect();
    btn.classList.add('correct');
    // 禁用所有按钮
    Array.from(suspectsEl.children).forEach(b => b.disabled = true);

    const level = levels[currentLevel];
    const bonus = triedWrong ? 10 : 20;
    totalScore += bonus;
    captured.push(suspect.name);
    results[currentLevel] = true;

    feedbackEl.className = 'feedback correct show';
    feedbackEl.innerHTML = `
      ✅ 抓到了！<strong>${suspect.name}</strong> 就是魔丸团成员。<br>
      ${level.explanation}<br>
      <span style="color:#ffd369;">+${bonus} 分</span>
    `;

    nextLevelBtn.classList.remove('hidden');
    renderProgress();
  } else {
    // 选错
    if (!triedWrong) {
      sfxHint();
      triedWrong = true;
      btn.classList.add('wrong');
      btn.disabled = true;
      const level = levels[currentLevel];
      feedbackEl.className = 'feedback hint show';
      feedbackEl.innerHTML = `💡 提示：${level.hint}<br>再选一次吧。`;
    } else {
      // 第二次选错，公布答案
      sfxWrong();
      Array.from(suspectsEl.children).forEach(b => b.disabled = true);
      // 找到真正的坏蛋并标绿
      Array.from(suspectsEl.children).forEach((b, i) => {
        const s = shuffled[i];
        if (s.isCulprit) b.classList.add('correct');
      });

      const level = levels[currentLevel];
      results[currentLevel] = false;

      feedbackEl.className = 'feedback wrong show';
      feedbackEl.innerHTML = `
        ❌ 又错了。正确答案是 <strong>${level.suspects.find(s => s.isCulprit).name}</strong>。<br>
        ${level.explanation}<br>
        <span style="color:#888;">这一关没有加分</span>
      `;

      nextLevelBtn.classList.remove('hidden');
      renderProgress();
    }
  }
}

nextLevelBtn.onclick = () => {
  sfxClick();
  currentLevel++;
  if (currentLevel >= levels.length) {
    showReport();
  } else {
    renderLevel();
  }
};

// ============================================================
// 结算
// ============================================================
function showReport() {
  sfxFinish();
  const count = captured.length;

  capturedCount.textContent = count + ' / 5';
  totalScoreEl.textContent = totalScore;

  let title, desc, trophyIcon;

  if (count === 5) {
    trophyIcon = '🏆';
    title = '金牌侦探';
    desc = '太厉害了！你把魔丸团 5 个成员全部抓到了。你非常了解中庸的意义：凡事不偏不倚，适可而止，顾及邻居的感受。';
  } else if (count >= 3) {
    trophyIcon = '🥈';
    title = '银牌侦探';
    desc = '不错！你抓到了大部分魔丸团成员。再仔细想想课本里说的‘中庸’：不浪费、有节制、说话得体、不夸大。';
  } else if (count >= 1) {
    trophyIcon = '🥉';
    title = '铜牌侦探';
    desc = '你抓到了一部分。魔丸团很狡猾，他们会假装成普通学生。下次注意观察：谁的行为没有顾及邻居？';
  } else {
    trophyIcon = '😵';
    title = '魔丸团逃走了';
    desc = '哎呀，一个都没抓到。再玩一次，仔细看每个同学的行为，想想课本里的‘中庸’是什么。';
  }

  trophy.textContent = trophyIcon;
  resultTitle.textContent = title;
  resultDesc.textContent = desc;

  // 显示抓到 / 逃走名单
  capturedList.innerHTML = '';
  const allNames = ['子轩', '诗雅', '伟杰', '欣怡', '宇航'];
  allNames.forEach(name => {
    const span = document.createElement('span');
    if (captured.includes(name)) {
      span.className = 'captured';
      span.textContent = '✅ ' + name;
    } else {
      span.className = 'escaped';
      span.textContent = '❌ ' + name;
    }
    capturedList.appendChild(span);
  });

  playerName.value = '';
  saveBtn.disabled = false;
  saveBtn.textContent = '💾 保存到排行榜';

  renderLeaderboard(leaderboardList);
  showPage(reportPage);
}

// ============================================================
// 排行榜
// ============================================================
function getLeaderboard() {
  try {
    const raw = localStorage.getItem('moralDetectiveLeaderboard');
    return raw ? JSON.parse(raw) : [];
  } catch (e) { return []; }
}

function saveLeaderboard(list) {
  try {
    localStorage.setItem('moralDetectiveLeaderboard', JSON.stringify(list));
  } catch (e) {}
}

function renderLeaderboard(targetEl) {
  const list = getLeaderboard();
  targetEl.innerHTML = '';

  if (list.length === 0) {
    targetEl.innerHTML = '<div class="empty">还没有记录，快来成为第一名！</div>';
    return;
  }

  list.sort((a, b) => b.score - a.score);
  const top5 = list.slice(0, 5);

  top5.forEach((entry, i) => {
    const li = document.createElement('li');
    if (i === 0) li.classList.add('top1');
    else if (i === 1) li.classList.add('top2');
    else if (i === 2) li.classList.add('top3');
    li.innerHTML = `<span>${i + 1}. ${entry.name}</span><span>${entry.score} 分 · ${entry.title}</span>`;
    targetEl.appendChild(li);
  });
}

saveBtn.onclick = () => {
  const name = playerName.value.trim() || '匿名侦探';
  const list = getLeaderboard();
  list.push({
    name: name,
    score: totalScore,
    title: resultTitle.textContent,
    date: Date.now()
  });
  saveLeaderboard(list);
  renderLeaderboard(leaderboardList);
  sfxCorrect();
  saveBtn.disabled = true;
  saveBtn.textContent = '✅ 已保存';
};

// ============================================================
// 重新开始
// ============================================================
restartBtn.onclick = () => {
  sfxClick();
  showPage(homePage);
};

</script>

